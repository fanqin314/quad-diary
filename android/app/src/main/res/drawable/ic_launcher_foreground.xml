<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标前景：四格象限。黑白灰四档，从白一路压到深灰，
     放在 #171A26 的底上，缩小到 48px 也还能看出是「四格」。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左上：过去 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,24 L50,24 L50,50 L24,50 Z" />
    <!-- 右上：未来 -->
    <path
        android:fillColor="#C9CBD6"
        android:pathData="M58,24 L84,24 L84,50 L58,50 Z" />
    <!-- 左下：情绪 -->
    <path
        android:fillColor="#8E91A3"
        android:pathData="M24,58 L50,58 L50,84 L24,84 Z" />
    <!-- 右下：留下的 -->
    <path
        android:fillColor="#4E5266"
        android:pathData="M58,58 L84,58 L84,84 L58,84 Z" />
</vector>
