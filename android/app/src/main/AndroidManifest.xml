<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      没有 INTERNET 权限，这是有意的：
      离线方案（assets + WebViewAssetLoader）全程只读本地文件，
      appassets.androidplatform.net 由 WebView 内部拦截，不会真的发网络请求。
      外链用系统的 ACTION_VIEW 交给浏览器，那也是别的应用在上网，与本应用无关。

      将来如果改成在线壳（方案 A），必须在这里补：
      <uses-permission android:name="android.permission.INTERNET" />
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuadDiary"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
